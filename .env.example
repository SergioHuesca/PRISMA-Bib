# Copy to .env (git-ignored) or, better, let prismabib write it:
#   prismabib credentials set scopus | openalex | unpaywall
#   prismabib credentials status
# Never put a key in a file whose name is not covered by .gitignore (.env or *.env).

# --- Mode "openalex" (no Scopus access) ---------------------------------------
# A free OpenAlex key lifts the daily budget; Unpaywall asks for a real contact email.
# OPENALEX_API_KEY=
# UNPAYWALL_EMAIL=

# --- Modes "scopus" and "scopus+openalex" -------------------------------------
# Elsevier key; the institutional token is needed off campus for the COMPLETE view.
# SCOPUS_API_KEY=
# SCOPUS_INSTTOKEN=
# ELSEVIER_SD_API_KEY=       # full text; may be the same key with different entitlements
# (OPENALEX_API_KEY and UNPAYWALL_EMAIL above also apply in these modes.)

# --- Any mode ------------------------------------------------------------------
PRISMABIB_PROJECTS_ROOT=./projects
