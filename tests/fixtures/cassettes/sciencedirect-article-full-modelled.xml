                <ce:section-title>Methods</ce:section-title>
                <ce:para>A synthetic methods paragraph describing nothing real.</ce:para>
              </ce:section>
              <ce:section>
                <ce:section-title>Results</ce:section-title>
                <ce:para>A synthetic results paragraph, likewise fictional.</ce:para>
              </ce:section>
            </ce:sections>
